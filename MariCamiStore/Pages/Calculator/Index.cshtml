@page
@model MariCamiStore.Pages.Calculator.IndexModel
@{
    ViewData["Title"] = "Calculadora de precios";
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Calculadora de precios</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Calculadora de precios</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- left column -->
            <div class="col-md-6">
                <!-- general form elements -->
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Calculadora</h3>
                    </div>
                    <!-- /.card-header -->
                    <!-- form start -->
                    <form role="form">
                        <div class="card-body">
                            <div class="form-group">
                                <label for="SupplierId">Proveedores</label>
                                <select class="form-control" id="SupplierId" name="SupplierId"></select>
                                <small id="NoSuppliersWarning" class="text-muted" style="display:none">No hay proveedores activos para la calculadora.</small>
                            </div>
                            <div class="form-group">
                                <label for="ListPrice">Precio de lista</label>
                                <input type="number" step="0.01" class="form-control" id="ListPrice" name="ListPrice" placeholder="Precio de lista">
                            </div>
                            <div class="form-group">
                                <label for="Vat">Impuesto</label>
                                <input type="number" step="0.01" class="form-control" id="Vat" name="Vat" placeholder="Impuesto" />
                                <label>%</label>
                            </div>
                            <div class="form-group">
                                <label for="ExchangeRate">Tipo de cambio</label>
                                <input type="number" step="0.01" class="form-control" id="ExchangeRate" name="ExchangeRate" placeholder="Tipo de cambio" />
                            </div>
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="FastShipping" name="FastShipping">
                                    <label class="custom-control-label" for="FastShipping">Envío rápido o local</label>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="Shipping">Costo envío</label>
                                <input type="number" step="0.01" class="form-control" id="Shipping" name="Shipping" placeholder="Costo envío" />
                            </div>
                            <div class="form-group">
                                <label for="ServiceCost">Costo servicio</label>
                                <input type="number" step="0.01" class="form-control" id="ServiceCost" name="ServiceCost" placeholder="Costo servicio" />
                            </div>
                            <div class="form-group">
                                <label>Precio con impuesto:</label>
                                <label id="PriceWithVAT" name="PriceWithVAT">0.0</label>
                            </div>
                            <div class="form-group">
                                <label>Precio en colones:</label>
                                <label id="PriceCOL" name="PriceCOL">0.0</label>
                            </div>
                            <div class="form-group">
                                <label>Total:</label>
                                <label class="bg-success color-palette" id="Total" name="Total">0.0</label>
                            </div>
                        </div>
                        <!-- /.card-body -->

                        <div class="card-footer">
                            <button type="button" id="btnCalculate" name="btnCalculate" class="btn btn-primary">Calcular</button>
                            <button type="button" id="btnClean" name="btnClean" class="btn btn-primary">Limpiar</button>
                        </div>
                    </form>
                </div>
                <!-- /.card -->

            </div>
            <!--/.col (left) -->
        </div>
        <!-- /.row -->
    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->

<script src="/js/pages/calculator/index.js" asp-append-version="true"></script>
