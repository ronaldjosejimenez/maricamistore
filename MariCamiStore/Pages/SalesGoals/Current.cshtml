@page
@model MariCamiStore.Pages.SalesGoals.CurrentModel
@{
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>Metas de Ventas - Mes Actual</h1></div>
        </div>
    </div>
</section>

<section class="content">

    <div id="goal-empty" class="alert alert-info" style="display:none;">
        No hay vendedores activos. Cree uno en Catálogos &rarr; Vendedores.
    </div>

    <div id="goal-error" class="alert alert-danger" style="display:none;"></div>

    <div id="goal-panel" style="display:none;">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title" id="goal-title">Meta del mes</h3>
            </div>
            <div class="card-body">
                <div id="distribution-banner" class="alert" role="status" style="display:none;"></div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="salesperson-select">Vendedor</label>
                            <select id="salesperson-select" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="currency-select">Moneda</label>
                            <select id="currency-select" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="goal-input">Meta del mes</label>
                            <input id="goal-input" type="number" step="0.01" min="0.01" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row text-center">
                    <div class="col-md-4">
                        <div class="info-box bg-light">
                            <div class="info-box-content">
                                <span class="info-box-text">Real</span>
                                <span class="info-box-number" id="actual-total" style="font-size:1.6rem;">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-box bg-light">
                            <div class="info-box-content">
                                <span class="info-box-text">% de cumplimiento</span>
                                <span class="info-box-number" id="compliance-total" style="font-size:1.6rem;">0%</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-box bg-light">
                            <div class="info-box-content">
                                <span class="info-box-text">% al día de hoy</span>
                                <span class="info-box-number" id="today-total" style="font-size:1.6rem;">0%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Detalle diario</h3></div>
            <div class="card-body table-responsive p-0">
                <table class="table table-sm table-hover" id="days-table">
                    <thead>
                        <tr>
                            <th>Día</th>
                            <th>Fecha</th>
                            <th class="text-right">Meta Propuesta</th>
                            <th class="text-right">Meta</th>
                            <th class="text-right">Real</th>
                            <th class="text-right">% Cumplimiento</th>
                            <th class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<style>
    .goal-red { background-color: #dc3545 !important; color: #fff; }
    .goal-yellow { background-color: #ffc107 !important; color: #212529; }
    .goal-green { background-color: #28a745 !important; color: #fff; }
    #days-table tr.today-row { font-weight: bold; background-color: #e9f5ff; }
    #days-table th, #days-table td { vertical-align: middle; }
    #days-table th.text-center, #days-table td.text-center { text-align: center; }
    #days-table input.cell-input { width: 140px; text-align: right; margin-left: auto; }
    #days-table input.cell-error { border-color: #dc3545; }
</style>

<script src="/js/pages/sales-goals/current.js" asp-append-version="true"></script>
