@page
@model MariCamiStore.Pages.SalesGoals.HistoryModel
@{
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>Histórico de Metas</h1></div>
        </div>
    </div>
</section>

<section class="content">
    <div id="history-empty-people" class="alert alert-info" style="display:none;">
        No hay vendedores registrados.
    </div>
    <div id="history-error" class="alert alert-danger" style="display:none;"></div>

    <div id="history-panel" style="display:none;">
        <div class="card card-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label for="salesperson-select">Vendedor</label>
                            <select id="salesperson-select" class="form-control"></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="history-list-card" class="card">
            <div class="card-header"><h3 class="card-title">Metas mensuales</h3></div>
            <div class="card-body table-responsive p-0">
                <div id="history-empty" class="alert alert-secondary m-3" style="display:none;">
                    Sin registros para este vendedor.
                </div>
                <table class="table table-sm table-hover" id="history-table">
                    <thead>
                        <tr>
                            <th>Mes</th>
                            <th>Año</th>
                            <th class="text-right">Meta</th>
                            <th class="text-right">Real</th>
                            <th class="text-right">% Cumplimiento</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div id="history-detail-card" class="card" style="display:none;">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0" id="detail-title">Detalle</h3>
                <button id="btn-back" class="btn btn-sm btn-secondary">Volver</button>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-sm table-hover" id="detail-table">
                    <thead>
                        <tr>
                            <th>Día</th>
                            <th>Fecha</th>
                            <th class="text-right">Meta Propuesta</th>
                            <th class="text-right">Meta</th>
                            <th class="text-right">Real</th>
                            <th class="text-right">% Cumplimiento</th>
                            <th class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script src="/js/pages/sales-goals/history.js" asp-append-version="true"></script>
